 }
 
+/* ==========================================================================
+   Centered Page-Transition Loading Overlay (`#laico-page-loader`)
+   ========================================================================== */
+.laico-page-loader {
+  position: fixed;
+  inset: 0;
+  z-index: 99999;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(11, 29, 51, 0.34);
+  backdrop-filter: blur(5px);
+  -webkit-backdrop-filter: blur(5px);
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+  transition: opacity 0.22s ease, visibility 0.22s ease;
+}
+
+.laico-page-loader.is-visible {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+}
+
+.laico-page-loader__box {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 14px;
+  padding: 24px 30px;
+  border-radius: 16px;
+  background: rgba(255, 255, 255, 0.96);
+  box-shadow: 0 20px 50px rgba(11, 29, 51, 0.22);
+  border: 1px solid rgba(11, 29, 51, 0.08);
+  transform: scale(0.96);
+  transition: transform 0.22s ease;
+}
+
+.laico-page-loader.is-visible .laico-page-loader__box {
+  transform: scale(1);
+}
+
+.laico-page-loader__spinner {
+  width: 38px;
+  height: 38px;
+  border-radius: 50%;
+  border: 2.5px solid rgba(11, 29, 51, 0.14);
+  border-top-color: var(--navy, #0b1d33);
+  animation: laicoPageSpin 0.78s linear infinite;
+}
+
+.laico-page-loader__label {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--navy, #0b1d33);
+  letter-spacing: 0.01em;
+}
+
+@keyframes laicoPageSpin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .laico-page-loader__spinner {
+    animation-duration: 1.8s;
+  }
+}
+
+/* ==========================================================================
+   Single Project `.pd-top` Subtle Featured-Image Background
+   ========================================================================== */
+.pd-top {
+  position: relative;
+  overflow: hidden;
+}
+
+.pd-top-bg {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  pointer-events: none;
+  overflow: hidden;
+}
+
+.pd-top-bg img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center;
+  opacity: 0.09;
+  filter: saturate(0.8) contrast(1.05);
+  transform: scale(1.03);
+}
+
+.pd-top > .pd-wrap,
+.pd-top > .ar-wrap {
+  position: relative;
+  z-index: 1;
+}
+
+/* ==========================================================================
+   WP Math Captcha Integration inside Theme Forms (`.laico-captcha-slot`)
+   ========================================================================== */
+.laico-captcha-slot {
+  margin: 10px 0 12px;
+}
+
+.laico-captcha-slot .wpmc-wrap {
+  margin: 0 !important;
+}
+
+.laico-captcha-slot .wpmc-box {
+  background: #ffffff;
+  border: 1px solid var(--line-strong, rgba(11, 29, 51, 0.2));
+  border-radius: var(--radius, 10px);
+  padding: 8px 12px;
+}
+
+.laico-captcha-slot.is-invalid .wpmc-box {
+  border-color: #c5221f;
+}
+
+.laico-captcha-slot .wpmc-input {
+  width: 78px !important;
+  height: 38px !important;
+  padding: 4px 8px !important;
+  border-radius: 7px !important;
+  direction: ltr !important;
+  text-align: center !important;
+}
+
+.laico-captcha-slot .field-error {
+  display: block;
+  margin-top: 5px;
+  font-size: 12.5px;
+  color: #c5221f;
+}
+
+.laico-captcha-slot .field-error:empty {
+  display: none;
+}
+
 /* Gutenberg Content Compatibility inside `.ar-body`, `.pd-text`, and `.prose` */
 .ar-body figure.wp-block-image,
 .pd-text figure.wp-block-image,
